{
  "name": "st-baibai-book-tsukiyo",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "vite build",
    "test": "vitest run && node scripts/test-time-rel.mjs && node scripts/test-vector-depth.mjs && node scripts/test-memory-regressions.mjs",
    "test:time": "node scripts/test-time-rel.mjs",
    "test:vector-depth": "node scripts/test-vector-depth.mjs",
    "test:memory": "node scripts/test-memory-regressions.mjs",
    "prewatch": "node scripts/sync-version.mjs",
    "watch": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "check:local": "node scripts/check-local-only.mjs",
    "verify": "npm run typecheck && npm test && npm run test:editor && npm run build && npm run check:local",
    "build:editor-tests": "tsc -p tsconfig.test.json && node -e \"require('node:fs').writeFileSync('.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test:editor": "npm run build:editor-tests && node tests/memory-editor/run-all.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "vue": "^3.5.35"
  },
  "description": "百宝月夜书：剧情剪辑台（楼层摘要树 / 状态账本 / 召回）+ 手写楼层补摘 + 可选手机联动 + 本地备份恢复（无白鸟远程后端）"
}
